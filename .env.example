# Copier ce fichier en .env pour le développement local.
# Ne jamais committer .env (voir .gitignore).

# --- Base de données ---
DATABASE_URL="postgresql://sejours:sejours@localhost:5433/sejours?schema=public"

# --- Sessions / auth ---
# Secret de signature des sessions (téléphone + OTP). Générer avec: openssl rand -base64 32
AUTH_SECRET="changeme-generate-a-real-secret"

# --- SMS (code à usage unique) ---
# "console" journalise le code au lieu de l'envoyer, pour le développement,
# et expose /api/dev/last-otp pour les tests de bout en bout. NE JAMAIS
# utiliser "console" en production : c'est cette valeur, pas NODE_ENV, qui
# ferme la route de secours (voir src/app/api/dev/last-otp/route.ts).
SMS_PROVIDER="console"

# --- Email (canal de secours optionnel pour le même code — décision 0014) ---
# Le téléphone reste le seul canal obligatoire ; l'email ne le remplace
# jamais. "console" journalise au lieu d'envoyer (développement) ; "smtp"
# envoie pour de vrai via un serveur SMTP standard (voir
# src/lib/email/provider.ts, SmtpEmailProvider) — en production, avec
# Migadu (smtp.migadu.com) ou tout autre hébergeur de boîte mail.
EMAIL_PROVIDER="console"

# Uniquement si EMAIL_PROVIDER="smtp". SMTP_PORT=465 => secure=true (TLS
# implicite) ; 587 => secure=false (STARTTLS, négocié automatiquement).
# SMTP_PASSWORD : le mot de passe de LA BOÎTE (Migadu : Admin → Mailboxes →
# la boîte → mot de passe), pas celui du compte d'administration Migadu.
# SMTP_HOST="smtp.migadu.com"
# SMTP_PORT="465"
# SMTP_USER="noreply@vd-technologies.com"
# SMTP_PASSWORD="changeme-mot-de-passe-de-la-boite"
# EMAIL_FROM="Séjours <noreply@vd-technologies.com>"

# --- Stockage objet des photographies (S3-compatible, MinIO en local) ---
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_REGION="us-east-1"
STORAGE_BUCKET="sejours-photos"
STORAGE_ACCESS_KEY_ID="sejours"
STORAGE_SECRET_ACCESS_KEY="sejours-secret"
STORAGE_FORCE_PATH_STYLE="true"

# --- Paiement (simulateur Mobile Money — voir docs/agile/decisions) ---
PAYMENT_PROVIDER="simulated"
PAYMENT_WEBHOOK_SECRET="changeme-generate-a-real-secret"

# --- Tâches planifiées déclenchées par HTTP (voir /api/payments/release-overdue) ---
CRON_SECRET="changeme-generate-a-real-secret"
